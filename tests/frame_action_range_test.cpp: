
#include "../src/Data/FrameActionRange.hpp"

#include <iostream>
#include <vector>

struct TestAction {
    int frame;
    int id;
};

int main() {
    std::vector<TestAction> actions = {
        {0, 10},
        {1, 11},
        {5, 50},
        {5, 51},
        {6, 60}
    };

    int failures = 0;

    auto check = [&](bool condition, const char* name) {
        if (!condition) {
            std::cerr << "FAIL: " << name << '\n';
            ++failures;
        } else {
            std::cout << "PASS: " << name << '\n';
        }
    };

    // First update: (-1, 1] includes frames 0 and 1.
    {
        auto it = afwc::firstActionAfterFrame(actions, -1);
        std::vector<int> found;

        while (it != actions.end() &&
               afwc::isActionDue(*it, 1)) {
            found.push_back(it->frame);
            ++it;
        }

        check(
            found.size() == 2 &&
            found[0] == 0 &&
            found[1] == 1,
            "first update includes frame 0 and frame 1"
        );
    }

    // Checkpoint interval: (4, 6] includes 5 and 6.
    {
        auto it = afwc::firstActionAfterFrame(actions, 4);
        std::vector<int> ids;

        while (it != actions.end() &&
               afwc::isActionDue(*it, 6)) {
            ids.push_back(it->id);
            ++it;
        }

        check(
            ids.size() == 3 &&
            ids[0] == 50 &&
            ids[1] == 51 &&
            ids[2] == 60,
            "checkpoint interval preserves both frame-5 actions"
        );
    }

    // No action at or before the current frame should be returned
    // when the last processed frame is already beyond all actions.
    {
        auto it = afwc::firstActionAfterFrame(actions, 6);

        check(
            it == actions.end(),
            "no old actions are processed twice"
        );
    }

    if (failures != 0) {
        std::cerr << failures << " test(s) failed.\n";
        return 1;
    }

    std::cout << "All frame-range tests passed.\n";
    return 0;
}
